# ==============================================================================
# FILE: .env.example
#
# PROGRAM SUMMARY
#   TEMPLATE for the real `.env` file. Copy it to `.env` and replace the placeholder values.
#   `.env` is git-ignored; this template is the only version that is committed.
#
# HOW IT WORKS
#   On Render, create the same variable names in Environment -> Environment Variables.
# USED BY    : backend/config.py reads these names
# ==============================================================================

# Copy this file to `.env` and fill in the values (local runs).
# On Render, set the same names as Environment Variables in the dashboard.

# --- Database (required) ---
# Atlas connection string, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/ .
# URL-encode special characters in the password (@ becomes %40). Paste it WITHOUT quotes.
MONGO_URI="YOUR_MONGO_URI"

# --- AI assistant (required for the chatbot) — https://console.groq.com ---
# Create at console.groq.com -> API Keys. Needed by the chatbot and guardrails.
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# --- Google Sign-In (optional — OAuth client from Google Cloud Console) ---
# Leave blank unless you set up Google Sign-In (needs a Google Cloud project).
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# --- Observability (optional — free tier at logfire.pydantic.dev) ---
# Write token from logfire.pydantic.dev (Project -> API keys -> scope "Send telemetry"); blank =
# no tracing.
LOGFIRE_TOKEN=""

# --- In-code model fallback (no third-party needed) ---
# Groq models tried in order if the main agent model fails (429 / 5xx / timeout). "" disables.
# AGENT_FALLBACK_MODEL_NAMES="openai/gpt-oss-120b"

# --- LLM gateway (optional — leave unset to call Groq directly) ---
# PORTKEY_API_KEY=""
# PORTKEY_GROQ_PROVIDER="groq"

# --- Online evals (optional, off by default; adds LLM judge calls) ---
# ONLINE_EVALS_ENABLED=false
